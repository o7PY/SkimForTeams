# Bot identity (Teams Developer Portal -> Bot management)
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__AUTHTYPE=ClientSecret
# Local testing without Teams only:
# CONNECTIONS__SERVICE_CONNECTION__SETTINGS__ANONYMOUS_ALLOWED=true

MICROSOFT_APP_ID=          # same as CLIENTID; used by build_manifest.py
DATABASE_URL=              # Supabase connection string
STORAGE=postgres           # postgres | memory
DEBUG_TOKEN=               # long random string
PAIRING_SECRET=            # long random string
PORT=8080
LOG_LEVEL=INFO
LOG_MESSAGE_TEXT=true      # set false before any real class uses this
